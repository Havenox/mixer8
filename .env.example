# =========================================================================
# TEMPLATE DE VARIÁVEIS DE AMBIENTE - MIXER8 (.env.example)
# Copie este arquivo como ".env" na raiz do projeto e preencha os valores reais.
# =========================================================================

# === AMBIENTE GERAL ===
ENVIRONMENT=development
ASPNETCORE_ENVIRONMENT=Development

# === CONFIGURAÇÕES DO MOISES EXTRACTOR (MICROSERVIÇO C#) ===
MOISES_EXTRACTOR_PORT=5010
MOISES_DOWNLOADS_DIR=./moises-extractor/downloads
MOISES_CONFIG_DIR=./moises-extractor/config

# === CONFIGURAÇÕES DA API PRINCIPAL (mixer8-api) ===
API_PORT=5000
JWT_SECRET=sua_chave_secreta_jwt_aqui_minimo_32_caracteres
JWT_EXPIRATION_DAYS=7

# === CONFIGURAÇÕES DO BANCO DE DADOS (PostgreSQL / SQL Server) ===
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=sua_senha_secreta_db
DB_NAME=mixer8_db
DB_CONNECTION_STRING=Host=${DB_HOST};Port=${DB_PORT};Database=${DB_NAME};Username=${DB_USER};Password=${DB_PASSWORD}

# === CONFIGURAÇÕES DO FRONTEND (mixer8-web - React+Vite) ===
WEB_PORT=3000
VITE_API_URL=http://localhost:5000/api
