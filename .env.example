# =========================================================================
# TEMPLATE DE VARIÁVEIS DE AMBIENTE - MIXER8 (.env.example)
# Copie este arquivo como ".env" na raiz do projeto e preencha os valores reais.
# =========================================================================

# === AMBIENTE GERAL ===
ENVIRONMENT=development
ASPNETCORE_ENVIRONMENT=Development

# === CONFIGURAÇÕES DO EXTRATOR DE STEMS (mixer8-extractor - C#) ===
EXTRACTOR_PORT=5010
EXTRACTOR_DOWNLOADS_DIR=./mixer8-extractor/downloads
EXTRACTOR_CONFIG_DIR=./mixer8-extractor/config
EXTRACTOR_LOGIN=suo_email_extrator_aqui@exemplo.com
EXTRACTOR_PASSWORD=sua_senha_secreta_extrator_aqui
EXTRACTOR_WAIT_TIME_BASE_SECONDS=180
EXTRACTOR_BROWSER_CHANNEL=

# === CONFIGURAÇÕES DA API PRINCIPAL (mixer8-api) ===
API_PORT=5000
JWT_SECRET=sua_chave_secreta_jwt_aqui_minimo_32_caracteres
JWT_EXPIRATION_DAYS=7

# === CONFIGURAÇÕES DO BANCO DE DADOS (PostgreSQL) ===
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=sua_senha_secreta_db
DB_NAME=mixer8_db
DB_CONNECTION_STRING=Host=${DB_HOST};Port=${DB_PORT};Database=${DB_NAME};Username=${DB_USER};Password=${DB_PASSWORD}

# === CONFIGURAÇÕES DO FRONTEND (mixer8-app - React+Vite) ===
WEB_PORT=3000
VITE_API_URL=http://localhost:5000

# === SEGURANÇA E CORS ===
# Define se a restrição de origem deve ser ligada (true) ou se a API fica aberta para qualquer origem (false)
CORS_RESTRICTED=false
# Origens (domínios) permitidos quando CORS_RESTRICTED=true (separe por vírgula para múltiplos domínios)
CORS_ALLOWED_ORIGINS=https://sua-plataforma.havenox.dev,http://localhost:3000

# === CONFIGURAÇÕES ADICIONAIS DO YT-DLP ===
# Argumentos extras para contornar bloqueios do YouTube (ex: HTTP 403 Forbidden).
# Em servidores de produção, a recomendação é utilizar a impersonação de TLS (--impersonate chrome)
# e forçar clientes específicos (--extractor-args "youtube:player_client=web_embedded,web")
YT_DLP_EXTRA_ARGS=

# === CONFIGURAÇÕES DE REDE DOCKER (MTU) ===
# MTU da rede bridge padrão do Docker. Em servidores conectados a túneis VPN (ex: WireGuard para contornar CGNAT),
# utilize 1420 para evitar descarte silencioso de pacotes (Path MTU Black Hole). Em conexões diretas, 1500 é o padrão.
DOCKER_NETWORK_MTU=1420

